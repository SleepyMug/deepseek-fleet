{
  "name": "deepseek-fleet",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "watch": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "test": "pnpm --filter './packages/*' test",
    "image": "pnpm build && pnpm --filter fleet-image image"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@types/node": "26.6.2",
    "fleet-client": "workspace:*",
    "fleet-core": "workspace:*",
    "typescript": "6.0.3"
  }
}
