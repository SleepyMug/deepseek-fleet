{
  "name": "@sleepymug/fleet-box",
  "version": "0.0.1",
  "description": "What fleet's gateway runs in each box, its helper, and the image it builds, Node with the helper on top",
  "type": "module",
  "exports": {
    "./image/build": {
      "types": "./lib/image/build.d.ts",
      "default": "./lib/image/build.js"
    },
    "./image/stage": {
      "types": "./lib/image/stage.d.ts",
      "default": "./lib/image/stage.js"
    },
    "./helper/serve": {
      "types": "./lib/helper/serve.d.ts",
      "default": "./lib/helper/serve.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "Dockerfile",
    "lib",
    "!lib/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "node -e \"for (const path of ['lib', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\" && tsc -b && node --test \"lib/**/*.test.js\""
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.4",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.4",
    "@sleepymug/fleet-protocol": "workspace:*",
    "node-pty": "1.2.0-beta.15"
  }
}
