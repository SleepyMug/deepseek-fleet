{
  "name": "fleet-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "fleet-box": "./lib/box/cli/main.js"
  },
  "exports": {
    "./box": {
      "types": "./lib/box/box.d.ts",
      "default": "./lib/box/box.js"
    },
    "./tau/plugin": {
      "types": "./lib/tau/plugin.d.ts",
      "default": "./lib/tau/plugin.js"
    },
    "./tau/runs-plugin": {
      "types": "./lib/tau/runs-plugin.d.ts",
      "default": "./lib/tau/runs-plugin.js"
    },
    "./world/fs": {
      "types": "./lib/world/fs.d.ts",
      "default": "./lib/world/fs.js"
    },
    "./world/subprocess": {
      "types": "./lib/world/subprocess.d.ts",
      "default": "./lib/world/subprocess.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.test.*",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "node -e \"for (const path of ['lib', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\" && tsc -b && node --test \"lib/**/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@sleepymug/tau": "0.1.0",
    "@sleepymug/ts-executor": "0.4.0",
    "fleet-image": "workspace:*",
    "fleet-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.7-rc.2"
  }
}
