{
  "name": "fleet-core",
  "version": "0.0.1",
  "private": true,
  "description": "The fleet host's core: fleet-box, the Docker execution world, one container per root session, served by fleet-image's helper inside it, with the session folder bind-mounted at the same path; and fleet-tau, which runs agent directories in the tau format as sessions, each with its agent's skills and its APIs linked to fleet's implementations, whose backends fleet's plugins provide",
  "type": "module",
  "exports": {
    "./box/world": {
      "types": "./lib/box/world.d.ts",
      "default": "./lib/box/world.js"
    },
    "./box/additions": {
      "types": "./lib/box/additions.d.ts",
      "default": "./lib/box/additions.js"
    },
    "./box/fs": {
      "types": "./lib/box/fs.d.ts",
      "default": "./lib/box/fs.js"
    },
    "./box/subprocess": {
      "types": "./lib/box/subprocess.d.ts",
      "default": "./lib/box/subprocess.js"
    },
    "./box/context": {
      "types": "./lib/box/context.d.ts",
      "default": "./lib/box/context.js"
    },
    "./tau/backends": {
      "types": "./lib/tau/backends.d.ts",
      "default": "./lib/tau/backends.js"
    },
    "./tau/spec": {
      "types": "./lib/tau/spec.d.ts",
      "default": "./lib/tau/spec.js"
    },
    "./tau/store": {
      "types": "./lib/tau/store.d.ts",
      "default": "./lib/tau/store.js"
    },
    "./tau/agent": {
      "types": "./lib/tau/agent.d.ts",
      "default": "./lib/tau/agent.js"
    },
    "./tau/relay": {
      "types": "./lib/tau/relay.d.ts",
      "default": "./lib/tau/relay.js"
    },
    "./tau/examples/notes": {
      "types": "./lib/tau/examples/notes.d.ts",
      "default": "./lib/tau/examples/notes.js"
    },
    "./tau/examples/archives": {
      "types": "./lib/tau/examples/archives.d.ts",
      "default": "./lib/tau/examples/archives.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.test.*",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "node -e \"for (const path of ['lib', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\" && tsc -b && node --test \"lib/**/*.test.js\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@sleepymug/tau": "0.1.0",
    "fleet-image": "workspace:*",
    "node-pty": "1.2.0-beta.15",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-workspace-files": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
