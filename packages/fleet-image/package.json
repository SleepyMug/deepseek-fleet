{
  "name": "fleet-image",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./layout": {
      "types": "./lib/layout.d.ts",
      "default": "./lib/layout.js"
    },
    "./helper/protocol": {
      "types": "./lib/helper/protocol.d.ts",
      "default": "./lib/helper/protocol.js"
    },
    "./image/build": {
      "types": "./lib/image/build.d.ts",
      "default": "./lib/image/build.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "Dockerfile",
    "lib",
    "!lib/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "node -e \"for (const path of ['lib', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\" && tsc -b && node --test \"lib/**/*.test.js\"",
    "image": "node lib/image/main.js"
  }
}
