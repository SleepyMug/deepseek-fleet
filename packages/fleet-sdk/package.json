{
  "name": "@sleepymug/fleet-sdk",
  "version": "0.0.1",
  "description": "The fleet host's SDK: boxes, their files, processes and terminals, for a harness; and the registration of a service, for its gateway",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@sleepymug/fleet-protocol": "workspace:*"
  }
}
