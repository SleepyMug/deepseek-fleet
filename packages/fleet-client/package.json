{
  "name": "fleet-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "fleet": "./lib/cli.js"
  },
  "exports": {
    "./connection": {
      "types": "./lib/connection.d.ts",
      "default": "./lib/connection.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "node -e \"for (const path of ['lib', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\" && tsc -b && node --test \"lib/**/*.test.js\""
  },
  "dependencies": {
    "@sleepymug/tau": "0.1.0",
    "fleet-protocol": "workspace:*"
  }
}
