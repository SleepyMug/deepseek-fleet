{
  "name": "@sleepymug/fleet-signin",
  "version": "0.0.1",
  "description": "One-shot terminal sign-in to a model provider, as a dsh profile of its own: `dsh plugin --profile fleet-signin add @sleepymug/fleet-signin` once, then `dsh fleet-signin [provider]`; a long-running profile must not select it",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./lib/app.d.ts",
      "default": "./lib/app.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-authorization": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-authorization": "0.2.0-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
