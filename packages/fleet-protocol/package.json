{
  "name": "@sleepymug/fleet-protocol",
  "version": "0.0.1",
  "description": "The wires of fleet's gateway, shared by its ends: to its clients, harnesses and fleet servers, to the helper in each box, and its channel; and where things lie in a box",
  "type": "module",
  "exports": {
    "./channel": {
      "types": "./lib/channel.d.ts",
      "default": "./lib/channel.js"
    },
    "./fleet": {
      "types": "./lib/fleet.d.ts",
      "default": "./lib/fleet.js"
    },
    "./helper": {
      "types": "./lib/helper.d.ts",
      "default": "./lib/helper.js"
    },
    "./layout": {
      "types": "./lib/layout.d.ts",
      "default": "./lib/layout.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  }
}
