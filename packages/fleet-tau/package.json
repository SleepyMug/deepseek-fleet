{
  "name": "fleet-tau",
  "version": "0.0.1",
  "private": true,
  "description": "The fleet's tau runtime: runs agent directories in the tau format as sessions of the fleet host, each with its agent's skills and the services fleet's plugins provide, from a spec the `fleet` command stores per session",
  "type": "module",
  "exports": {
    "./services": {
      "types": "./lib/services.d.ts",
      "default": "./lib/services.js"
    },
    "./spec": {
      "types": "./lib/spec.d.ts",
      "default": "./lib/spec.js"
    },
    "./store": {
      "types": "./lib/store.d.ts",
      "default": "./lib/store.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./relay": {
      "types": "./lib/relay.d.ts",
      "default": "./lib/relay.js"
    },
    "./examples/notes": {
      "types": "./lib/examples/notes.d.ts",
      "default": "./lib/examples/notes.js"
    },
    "./examples/archives": {
      "types": "./lib/examples/archives.d.ts",
      "default": "./lib/examples/archives.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.test.*",
    "manifests",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "node -e \"for (const path of ['lib', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\" && tsc -b && node --test \"lib/**/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@sleepymug/tau": "0.1.0",
    "fleet-box-helper": "workspace:*",
    "fleet-tau-runner": "workspace:*",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "fleet-box": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "fleet-box": "workspace:*"
  }
}
