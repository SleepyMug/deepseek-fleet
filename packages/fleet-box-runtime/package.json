{
  "name": "@sleepymug/fleet-box-runtime",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "fleet-box-image": "./lib/image/main.js"
  },
  "exports": {
    "./layout": {
      "types": "./lib/layout.d.ts",
      "default": "./lib/layout.js"
    },
    "./helper/protocol": {
      "types": "./lib/helper/protocol.d.ts",
      "default": "./lib/helper/protocol.js"
    },
    "./ext/client": {
      "types": "./lib/ext/client.d.ts",
      "default": "./lib/ext/client.js"
    },
    "./ext/tau": {
      "types": "./lib/ext/tau.d.ts",
      "default": "./lib/ext/tau.js"
    },
    "./tau/endpoint": {
      "types": "./lib/tau/endpoint.d.ts",
      "default": "./lib/tau/endpoint.js"
    },
    "./tau/protocol": {
      "types": "./lib/tau/protocol.d.ts",
      "default": "./lib/tau/protocol.js"
    },
    "./tau/layout": {
      "types": "./lib/tau/layout.d.ts",
      "default": "./lib/tau/layout.js"
    },
    "./image/build": {
      "types": "./lib/image/build.d.ts",
      "default": "./lib/image/build.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "Dockerfile",
    "lib",
    "!lib/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "node -e \"for (const path of ['lib', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\" && tsc -b && node --test \"lib/**/*.test.js\"",
    "image": "node lib/image/main.js"
  },
  "dependencies": {
    "@sleepymug/tau": "0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "node-pty": "1.2.0-beta.15"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "node-pty": "1.2.0-beta.15"
  }
}
