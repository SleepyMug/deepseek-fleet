{
  "tau": "../../../examples/relay",
  "call": {
    "files": {
      "report": "out/report.txt"
    },
    "args": {
      "word": "hello"
    }
  },
  "steps": [
    {
      "tool": "bash",
      "args": {
        "command": "tau run /tau/self/taus/shout --call-json '{\"files\": {\"out\": \"/tau/out/report.txt\"}, \"args\": {\"text\": \"hello\"}}' --json",
        "description": "Run the shout TAU on the word"
      }
    }
  ],
  "final": "It said: Shouted.",
  "runs": [
    {
      "match": "in capital letters to",
      "steps": [
        {
          "tool": "write",
          "args": {
            "file_path": "/tau/out/report.txt",
            "content": "HELLO\n"
          }
        }
      ],
      "final": "Shouted."
    }
  ]
}
